<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="24dp">
            <Button android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp"
                android:text="←" android:backgroundTint="@color/card_bg" android:padding="0dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="🎁 Ödül Sistemi" android:textColor="@color/text_primary" android:textSize="22sp"
                android:textStyle="bold" android:layout_marginStart="12dp"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/remainingText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Kalan süre: 60dk"
                    android:textColor="@color/accent_green" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:id="@+id/usedText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Kullanılan: 0dk"
                    android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/limitText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Günlük limit: 60dk"
                    android:textColor="@color/text_hint" android:textSize="13sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ÖDÜL SEÇ (PIN gerekli)" android:textColor="@color/text_hint"
            android:textSize="11sp" android:letterSpacing="0.1" android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btnHomework" android:layout_width="match_parent" android:layout_height="64dp"
            android:text="📚 Ödev Yaptı   +10 dakika" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="@color/accent_blue" android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnReading" android:layout_width="match_parent" android:layout_height="64dp"
            android:text="📖 Kitap Okudu   +15 dakika" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="@color/accent_purple" android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnChores" android:layout_width="match_parent" android:layout_height="64dp"
            android:text="🧹 Ev İşi Yaptı   +10 dakika" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="@color/accent_green" android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnCustom" android:layout_width="match_parent" android:layout_height="64dp"
            android:text="✏️ Özel Süre Ekle" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="@color/card_bg"/>
    </LinearLayout>
</ScrollView>
