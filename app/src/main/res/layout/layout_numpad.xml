<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:columnCount="3"
    android:rowCount="4"
    android:padding="8dp">

    <Button android:id="@+id/btn1" android:text="1" style="@style/NumpadButton"/>
    <Button android:id="@+id/btn2" android:text="2" style="@style/NumpadButton"/>
    <Button android:id="@+id/btn3" android:text="3" style="@style/NumpadButton"/>
    <Button android:id="@+id/btn4" android:text="4" style="@style/NumpadButton"/>
    <Button android:id="@+id/btn5" android:text="5" style="@style/NumpadButton"/>
    <Button android:id="@+id/btn6" android:text="6" style="@style/NumpadButton"/>
    <Button android:id="@+id/btn7" android:text="7" style="@style/NumpadButton"/>
    <Button android:id="@+id/btn8" android:text="8" style="@style/NumpadButton"/>
    <Button android:id="@+id/btn9" android:text="9" style="@style/NumpadButton"/>

    <Space
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_columnWeight="1"/>

    <Button android:id="@+id/btn0" android:text="0" style="@style/NumpadButton"/>

    <Button
        android:id="@+id/btnDelete"
        android:text="⌫"
        android:textSize="20sp"
        style="@style/NumpadButton"
        android:backgroundTint="#FF4444"/>

</GridLayout>
