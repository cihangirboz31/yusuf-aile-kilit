<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView android:layout_width="72dp" android:layout_height="72dp"
            android:src="@drawable/ic_shield" android:layout_gravity="center"
            android:layout_marginTop="24dp" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="İzinleri Etkinleştir" android:textColor="@color/text_primary"
            android:textSize="24sp" android:textStyle="bold" android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Uygulama çalışabilmek için aşağıdaki izinlere ihtiyaç duyar"
            android:textColor="@color/text_secondary" android:textSize="14sp"
            android:gravity="center" android:layout_marginBottom="24dp"/>

        <TextView android:id="@+id/usageStatusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="❌ Kullanım İstatistikleri: GEREKLİ"
            android:textColor="@color/accent_red" android:textSize="14sp" android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/overlayStatusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="❌ Diğer Uygulamaların Üzerinde: GEREKLİ"
            android:textColor="@color/accent_red" android:textSize="14sp" android:layout_marginBottom="24dp"/>

        <Button android:id="@+id/btnUsageAccess" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="8dp"
            android:text="1. Kullanım İstatistikleri İzni Ver"
            android:backgroundTint="@color/accent_blue" android:textStyle="bold"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ayarlar açılır → 'Yusuf Aile Kilit' uygulamasını bulun → Etkinleştirin"
            android:textColor="@color/text_hint" android:textSize="12sp" android:layout_marginBottom="16dp"
            android:layout_marginStart="8dp"/>

        <Button android:id="@+id/btnOverlay" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="8dp"
            android:text="2. Diğer Uygulamaların Üzerinde İzni Ver"
            android:backgroundTint="@color/accent_purple" android:textStyle="bold"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Listeden uygulamayı bulun → İzin verin"
            android:textColor="@color/text_hint" android:textSize="12sp" android:layout_marginBottom="16dp"
            android:layout_marginStart="8dp"/>

        <Button android:id="@+id/btnAccessibility" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="8dp"
            android:text="3. Erişilebilirlik Servisi Aç (Önerilen)"
            android:backgroundTint="@color/bg_darker" android:textStyle="bold"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="'Yusuf Aile Kilit' → 'Uygulama İzleme Servisi' → Aç"
            android:textColor="@color/text_hint" android:textSize="12sp" android:layout_marginBottom="16dp"
            android:layout_marginStart="8dp"/>

        <Button android:id="@+id/btnBatteryOpt" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="8dp"
            android:text="4. Pil Optimizasyonu Kapat (Önerilen)"
            android:backgroundTint="@color/bg_darker" android:textStyle="bold"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Servisin arka planda sürekli çalışması için gerekli"
            android:textColor="@color/text_hint" android:textSize="12sp" android:layout_marginBottom="32dp"
            android:layout_marginStart="8dp"/>

        <Button android:id="@+id/btnContinue" android:layout_width="match_parent"
            android:layout_height="60dp" android:text="DEVAM ET →"
            android:backgroundTint="@color/accent_green" android:textSize="18sp"
            android:textStyle="bold" android:layout_marginBottom="32dp"/>
    </LinearLayout>
</ScrollView>
