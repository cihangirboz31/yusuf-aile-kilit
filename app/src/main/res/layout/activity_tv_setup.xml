<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <Button android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp"
                android:text="←" android:backgroundTint="@color/card_bg" android:padding="0dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="TV Kurulum" android:textColor="@color/text_primary" android:textSize="22sp"
                android:textStyle="bold" android:layout_marginStart="12dp"/>
        </LinearLayout>

        <!-- TV Tipi -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📺 TV Tipini Seçin" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btnArcelik" android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Arçelik TV"
                        android:textSize="12sp" android:backgroundTint="@color/bg_darker"/>
                    <Button android:id="@+id/btnTurkcell" android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:layout_marginHorizontal="4dp" android:text="Turkcell TV+"
                        android:textSize="12sp" android:backgroundTint="@color/bg_darker"/>
                    <Button android:id="@+id/btnAndroidTv" android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:layout_marginStart="4dp" android:text="Android TV"
                        android:textSize="12sp" android:backgroundTint="@color/accent_blue"/>
                </LinearLayout>
                <TextView android:id="@+id/tvTypeInfo" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Android TV / Google TV seçildi. Port: 6466"
                    android:textColor="@color/text_hint" android:textSize="12sp" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bağlantı -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔗 TV'ye Bağlan" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                <Button android:id="@+id/btnScanNetwork" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="🔍 Ağı Tara (Otomatik Bul)"
                    android:backgroundTint="@color/bg_darker" android:layout_marginBottom="8dp"/>
                <ProgressBar android:id="@+id/scanProgress" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:visibility="gone"/>
                <TextView android:id="@+id/scanResultText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:layout_marginBottom="12dp"/>
                <EditText android:id="@+id/ipInput" android:layout_width="match_parent"
                    android:layout_height="48dp" android:hint="TV IP adresi (örn: 192.168.1.10)"
                    android:textColorHint="@color/text_hint" android:textColor="@color/text_primary"
                    android:inputType="text" android:background="@drawable/input_bg"
                    android:paddingHorizontal="12dp" android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btnConnect" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="Bağlan ve Eşleştir"
                    android:backgroundTint="@color/accent_green"/>
                <ProgressBar android:id="@+id/connectProgress" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:visibility="gone" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/connectionStatusText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="" android:textColor="@color/text_secondary"
                    android:textSize="14sp" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Uzaktan Kumanda -->
        <LinearLayout android:id="@+id/controlsLayout" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎮 Uzaktan Kumanda" android:textColor="@color/text_primary"
                        android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btnPower" android:layout_width="56dp" android:layout_height="48dp"
                            android:text="⏻" android:backgroundTint="@color/accent_red" android:layout_marginEnd="8dp"/>
                        <Button android:id="@+id/btnHome" android:layout_width="0dp" android:layout_height="48dp"
                            android:layout_weight="1" android:text="🏠 Ana Ekran" android:backgroundTint="@color/bg_darker" android:layout_marginEnd="8dp"/>
                        <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="48dp"
                            android:layout_weight="1" android:text="← Geri" android:backgroundTint="@color/bg_darker"/>
                    </LinearLayout>

                    <!-- Yön tuşları -->
                    <GridLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:columnCount="3" android:layout_gravity="center" android:layout_marginBottom="8dp">
                        <Space android:layout_width="56dp" android:layout_height="56dp"/>
                        <Button android:id="@+id/btnUp" android:layout_width="56dp" android:layout_height="56dp"
                            android:text="▲" android:backgroundTint="@color/bg_darker"/>
                        <Space android:layout_width="56dp" android:layout_height="56dp"/>
                        <Button android:id="@+id/btnLeft" android:layout_width="56dp" android:layout_height="56dp"
                            android:text="◀" android:backgroundTint="@color/bg_darker"/>
                        <Button android:id="@+id/btnOk" android:layout_width="56dp" android:layout_height="56dp"
                            android:text="OK" android:backgroundTint="@color/accent_blue"/>
                        <Button android:id="@+id/btnRight" android:layout_width="56dp" android:layout_height="56dp"
                            android:text="▶" android:backgroundTint="@color/bg_darker"/>
                        <Space android:layout_width="56dp" android:layout_height="56dp"/>
                        <Button android:id="@+id/btnDown" android:layout_width="56dp" android:layout_height="56dp"
                            android:text="▼" android:backgroundTint="@color/bg_darker"/>
                        <Space android:layout_width="56dp" android:layout_height="56dp"/>
                    </GridLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btnVolDown" android:layout_width="0dp" android:layout_height="48dp"
                            android:layout_weight="1" android:text="🔉" android:backgroundTint="@color/bg_darker" android:layout_marginEnd="4dp"/>
                        <Button android:id="@+id/btnMute" android:layout_width="0dp" android:layout_height="48dp"
                            android:layout_weight="1" android:text="🔇" android:backgroundTint="@color/bg_darker" android:layout_marginHorizontal="4dp"/>
                        <Button android:id="@+id/btnVolUp" android:layout_width="0dp" android:layout_height="48dp"
                            android:layout_weight="1" android:text="🔊" android:backgroundTint="@color/bg_darker" android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <Button android:id="@+id/btnBlockYoutubeTv" android:layout_width="match_parent"
                        android:layout_height="52dp" android:text="🔒 TV'de YouTube'u Kapat"
                        android:backgroundTint="@color/accent_red" android:textStyle="bold"/>

                    <Button android:id="@+id/btnDisconnect" android:layout_width="match_parent"
                        android:layout_height="48dp" android:text="TV Bağlantısını Kes"
                        android:backgroundTint="@color/bg_darker" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- TV Desteklenmiyor -->
        <LinearLayout android:id="@+id/notSupportedLayout" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="⚠️ Bu TV doğrudan kontrol edilemiyor."
                        android:textColor="@color/accent_red" android:textSize="16sp" android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary" android:textSize="14sp"
                        android:text="TV veya TV+ kutusu, Android TV Remote protokolünü (port 6466) desteklemiyor.\n\nAlternatif çözümler:\n• Modem/router üzerinden YouTube engelleme\n• TV'nin kendi ebeveyn kilidi ayarları\n• YouTube Kids profili kurulumu\n\nDetaylı rehber için 'En Güçlü Koruma' bölümüne bakın."/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
